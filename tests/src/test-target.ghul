namespace Tests is
    use Collections.LIST

    use Tester

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    @TestClass()
    class TEST_TARGET_Should is

        init() is si

        with_flags(flags: string) -> TEST => TEST("path", LIST[string](), flags, false, LIST[string]())

        @Test()
        TEST__is_wasm__given_target_wasm__is_true() is
            should(with_flags("--target wasm").is_wasm()).be_true("", [])
        si

        @Test()
        TEST__is_wasm__given_target_wasm_among_other_flags__is_true() is
            should(with_flags("--library\n--target  wasm --wat il.out").is_wasm()).be_true("", [])
        si

        @Test()
        TEST__is_wasm__given_target_dotnet__is_false() is
            should(with_flags("--target dotnet").is_wasm()).be_false("", [])
        si

        @Test()
        TEST__is_wasm__given_no_target__is_false() is
            should(with_flags("--library").is_wasm()).be_false("", [])
        si

        @Test()
        TEST__is_wasm__given_target_as_the_last_word__is_false() is
            should(with_flags("--target").is_wasm()).be_false("", [])
        si

        @Test()
        PROJECT_OPTIONS__options_in__given_a_project_with_ghul_options__is_their_value() is
            let project = "<Project>\n  <PropertyGroup>\n    <GhulOptions>--target wasm</GhulOptions>\n  </PropertyGroup>\n</Project>"

            should(TEST.names_wasm_target(PROJECT_OPTIONS.options_in(project))).be_true("", [])
        si

        @Test()
        PROJECT_OPTIONS__options_in__given_several_ghul_options__joins_them() is
            let project = "<Project><GhulOptions>--library</GhulOptions><GhulOptions>--target wasm</GhulOptions></Project>"

            should(TEST.names_wasm_target(PROJECT_OPTIONS.options_in(project))).be_true("", [])
        si

        @Test()
        PROJECT_OPTIONS__options_in__given_no_ghul_options__names_no_wasm_target() is
            let project = "<Project><PropertyGroup><OutputType>Exe</OutputType></PropertyGroup></Project>"

            should(TEST.names_wasm_target(PROJECT_OPTIONS.options_in(project))).be_false("", [])
        si

        @Test()
        PROJECT_OPTIONS__options_in__given_a_malformed_project__names_no_wasm_target() is
            let project = "<GhulOptions>--target wasm"

            should(TEST.names_wasm_target(PROJECT_OPTIONS.options_in(project))).be_false("", [])
        si

        @Test()
        PROJECT_OPTIONS__options_in__given_a_ghul_options_item__reads_its_include() is
            let project = "<Project><ItemGroup><GhulOptions Include=\"--target wasm\" /></ItemGroup></Project>"

            should(TEST.names_wasm_target(PROJECT_OPTIONS.options_in(project))).be_true("", [])
        si

        @Test()
        PROJECT_OPTIONS__options_in__given_a_project_in_the_msbuild_namespace__reads_its_options() is
            let project = "<Project xmlns=\"http://schemas.microsoft.com/developer/msbuild/2003\"><PropertyGroup><GhulOptions>--target wasm</GhulOptions></PropertyGroup></Project>"

            should(TEST.names_wasm_target(PROJECT_OPTIONS.options_in(project))).be_true("", [])
        si
    si
si
