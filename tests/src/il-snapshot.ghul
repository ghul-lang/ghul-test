namespace Tests is
    use Collections.LIST
    use Collections.List
    use Ghul.Pipes

    use Tester

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    @TestClass()
    class IL_SNAPSHOT_Should is

        init() is si

        // The shape ildasm writes for a whole assembly: the container
        // preamble, the members section, and the closing rule.
        _whole_assembly() -> List[string] static =>
            [
                "// Metadata version: v4.0.30319",
                ".assembly extern 'ghul-runtime'",
                "{{",
                "  .ver 8:0:1:0",
                "}}",
                ".module binary.dll",
                ".imagebase 0x00400000",
                "",
                "",
                "// =============== CLASS MEMBERS DECLARATION ===================",
                "",
                ".class public auto ansi beforefieldinit Test.MAIN",
                "{{",
                "  .field assembly int32 _test",
                "}} // end of class Test.MAIN",
                "",
                "",
                "// =============================================================",
                "",
                "// *********** DISASSEMBLY COMPLETE ***********************"
            ]

        @Test()
        IL_SNAPSHOT__narrow__keeps_only_the_members_section() is

            let narrowed = IL_SNAPSHOT.narrow(_whole_assembly())

            should(narrowed.count).be(4, "", [])
            should(narrowed[0]).be(
                ".class public auto ansi beforefieldinit Test.MAIN", "", [])
            should(narrowed[3]).be("}} // end of class Test.MAIN", "", [])
        si

        @Test()
        IL_SNAPSHOT__narrow__drops_the_extern_versions_that_drift() is

            let narrowed = IL_SNAPSHOT.narrow(_whole_assembly())

            should(narrowed |> any(line => line.contains(".ver "))).be_false("", [])
            should(
                narrowed |> any(line => line.contains(".assembly extern"))
            ).be_false("", [])
        si

        // The whole point of narrowing: a snapshot must not move when a
        // dependency's version does.
        @Test()
        IL_SNAPSHOT__narrow__is_unchanged_by_a_dependency_version_bump() is

            let bumped =
                _whole_assembly()
                    |> map(line => if line == "  .ver 8:0:1:0" then "  .ver 10:1:3:0" else line fi)
                    |> collect_mutable()

            let before = IL_SNAPSHOT.narrow(_whole_assembly())
            let after = IL_SNAPSHOT.narrow(bumped)

            should(after.count).be(before.count, "", [])

            for i in 0..before.count do
                should(after[i]).be(before[i], "", [])
            od
        si

        @Test()
        IL_SNAPSHOT__narrow__given_no_members_banner__keeps_everything() is

            let sliced = ["ldloc.0", "throw"]

            let narrowed = IL_SNAPSHOT.narrow(sliced)

            should(narrowed.count).be(2, "", [])
            should(narrowed[0]).be("ldloc.0", "", [])
            should(narrowed[1]).be("throw", "", [])
        si

        @Test()
        IL_SNAPSHOT__narrow__drops_the_lines_that_differ_between_runs() is

            let lines =
                [
                    "// =============== CLASS MEMBERS DECLARATION ===================",
                    "// MVID: {{01234567-89ab-cdef-0123-456789abcdef}}",
                    "// Image base: 0x00007F0000000000",
                    ".class public Test.MAIN"
                ]

            let narrowed = IL_SNAPSHOT.narrow(lines)

            should(narrowed.count).be(1, "", [])
            should(narrowed[0]).be(".class public Test.MAIN", "", [])
        si
    si
si
