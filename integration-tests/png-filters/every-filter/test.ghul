use IO.Std
use Collections.LIST
use Ghul.Pipes

let width = 16
let height = 12

let raw = LIST[ubyte]()

for y in 0..height do
    raw.add(0ub)

    for x in 0..width do
        raw.add(cast ubyte((x * 13 + y * 7) % 256))
        raw.add(cast ubyte((x * 3 + y * 29) % 256))
        raw.add(cast ubyte((x * y) % 256))
    od
od

for name in ["base", "f0", "f1", "f2", "f3", "f4"] do
    IO.File.write_all_bytes("{name}.png", png(raw))
od

Std.write_line("ok")

png(raw: LIST[ubyte]) -> ARRAY[ubyte] =>
    (let out = LIST[ubyte]()

     for value in [137ub, 80ub, 78ub, 71ub, 13ub, 10ub, 26ub, 10ub] do
         out.add(value)
     od

     let header = LIST[ubyte]()

     be32(header, width)
     be32(header, height)

     for value in [8ub, 2ub, 0ub, 0ub, 0ub] do
         header.add(value)
     od

     chunk(out, "IHDR", header)
     chunk(out, "IDAT", zlib(raw))
     chunk(out, "IEND", LIST[ubyte]())

     out |> collect())

be32(out: LIST[ubyte], value: int) is
    out.add(cast ubyte((value >> 24) & 0xFF))
    out.add(cast ubyte((value >> 16) & 0xFF))
    out.add(cast ubyte((value >> 8) & 0xFF))
    out.add(cast ubyte(value & 0xFF))
si

zlib(raw: LIST[ubyte]) -> LIST[ubyte] =>
    (let out = LIST[ubyte]()

     out.add(0x78ub)
     out.add(0x01ub)
     out.add(1ub)
     out.add(cast ubyte(raw.count & 0xFF))
     out.add(cast ubyte((raw.count >> 8) & 0xFF))
     out.add(cast ubyte((raw.count & 0xFF) ^ 0xFF))
     out.add(cast ubyte(((raw.count >> 8) & 0xFF) ^ 0xFF))

     for value in raw do
         out.add(value)
     od

     let low mut = 1
     let high mut = 0

     for value in raw do
         low = (low + cast int(value)) % 65521
         high = (high + low) % 65521
     od

     be32(out, (high << 16) | low)

     out)

chunk(out: LIST[ubyte], kind: string, data: LIST[ubyte]) is
    be32(out, data.count)

    let body = LIST[ubyte]()

    for letter in kind do
        body.add(cast ubyte(letter))
    od

    for value in data do
        body.add(value)
    od

    for value in body do
        out.add(value)
    od

    be32(out, crc32(body))
si

crc32(data: LIST[ubyte]) -> int =>
    (let remainder mut = 0xFFFFFFFFu

     for value in data do
         remainder = remainder ^ cast uint(value)

         for _ in 0..8 do
             remainder =
                 if (remainder & 1u) != 0u then
                     0xEDB88320u ^ (remainder >>> 1)
                 else
                     remainder >>> 1
                 fi
         od
     od

     cast int(remainder ^ 0xFFFFFFFFu))
