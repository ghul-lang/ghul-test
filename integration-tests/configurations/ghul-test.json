{
    // The runner's own runs of its tests: the compiler the tool manifest
    // pins, and the runtime the runner was built with.
    "default": "tool",
    "configurations": {
        "tool": {
            "compiler": "tool",
            "runtime": { "path": "../../bin/Debug/net10.0/ghul-runtime.dll" }
        },
        "extended": {
            "extends": "tool"
        },
        "with-target-flags": {
            "extends": "tool",
            "targets": { "dotnet": { "flags": "--define extra" } }
        },
        "wasm-only": {
            "extends": "tool",
            "run_targets": ["wasm"]
        },
        "dotnet-only": {
            "extends": "tool",
            "run_targets": ["dotnet"]
        },
        "unknown-target": {
            "extends": "tool",
            "run_targets": ["cobol"]
        },
        "no-runtime": {
            "compiler": "tool"
        }
    }
}
