{
    // The runner's own runs of its tests: the compiler the tool manifest
    // pins, and the runtime the runner was built with.
    "default": "tool",
    "configurations": {
        "tool": {
            "compiler": "tool",
            "runtime": { "path": "../../bin/Debug/net10.0/ghul-runtime.dll" }
        },
        "extended": {
            "extends": "tool"
        },
        "with-target-flags": {
            "extends": "tool",
            "targets": { "dotnet": { "flags": "--define extra" } }
        },
        "wasm-only": {
            "extends": "tool",
            "run_targets": ["wasm"]
        },
        "dotnet-only": {
            "extends": "tool",
            "run_targets": ["dotnet"]
        },
        "unknown-target": {
            "extends": "tool",
            "run_targets": ["cobol"]
        },
        "build-targets": {
            "extends": "tool",
            "build_targets": ["dotnet", "wasm"],
            "run_targets": ["dotnet"]
        },
        "build-targets-unknown": {
            "extends": "tool",
            "build_targets": ["dotnet", "cobol"]
        },
        "no-runtime": {
            "compiler": "tool"
        },
        // A compiler run as written, which records the arguments it is given
        // and fails the build: handed the reference assemblies, as a .NET
        // compiler is, and not, as one hosted elsewhere is.
        "recorded": {
            "extends": "tool",
            "compiler": { "path": "record-compiler.sh" }
        },
        // The loader a library names reaches a wasm build that brings its
        // own core library, without the library's sources.
        "recorded-loader": {
            "extends": "tool",
            "compiler": { "path": "record-compiler.sh", "reference_assemblies": false },
            "run_targets": ["wasm"],
            "targets": {
                "wasm": {
                    "libraries": [
                        {
                            "name": "loader-library",
                            "root": "loader-library",
                            "sources": "src/**/*.ghul",
                            "loader": "loader.mjs"
                        }
                    ]
                }
            }
        },
        "recorded-no-references": {
            "extends": "tool",
            "compiler": { "path": "record-compiler.sh", "reference_assemblies": false }
        },
        "bad-references": {
            "extends": "tool",
            "compiler": { "path": "record-compiler.sh", "reference_assemblies": "no" }
        },
        "three-processes": {
            "extends": "tool",
            "processes": 3
        },
        "no-processes": {
            "extends": "tool",
            "processes": 0
        }
    }
}
