namespace Tester is
    use System.Exception
    use IO.File
    use IO.Path
    use IO.Directory
    use IO.DirectoryInfo

    use Collections.Iterable
    use Ghul.Pipes
    use Collections.LIST

    use Pair = Collections.KeyValuePair

    enum CompilerRunMode is
        CI,
        LOCAL,
        DOTNET,
        GHUL_CLI
    si

    class COMPILER_UNDER_TEST(run_mode: CompilerRunMode private) is
        _publish: string
        _executable: string
        _runtime_path: string
        _sdk_reference_path: string
        _arguments: Iterable[string]
        _use_dotnet: bool
        _compiler_command: string?

        @suppress("field-definite-assignment")
        init(..) is
            if _run_mode == CompilerRunMode.GHUL_CLI then
                _executable = "ghul"
                _arguments = ["build"]
            elif _run_mode == CompilerRunMode.DOTNET then
                _executable = "dotnet"
                _arguments = ["build"]
                _compiler_command = discover_compiler_command()
            elif _run_mode == CompilerRunMode.CI then
                _executable = "dotnet"
                _runtime_path = get_ghul_test_runtime_path()
                _sdk_reference_path = discover_sdk_reference_path()
                _arguments = ["ghul-compiler", "--v3", "--test-run"]
            elif _run_mode == CompilerRunMode.LOCAL then
                _publish = find_publish_directory()

                _executable = find_published_compiler()
                _runtime_path = get_published_compiler_path("ghul-runtime.dll")
                _sdk_reference_path = discover_sdk_reference_path()
                _arguments = ["--v3", "--test-run"]
            else
                throw Exception("unknown run mode: {_run_mode}")
            fi
        si

        // A dotnet-build test's sources come from its project rather than
        // from the runner, so the formatter phase has nothing to format.
        is_dotnet_build: bool => _run_mode == CompilerRunMode.DOTNET

        // A ghul-cli test is a project whose manifest says what to build and
        // with which compiler and libraries.
        is_ghul_cli: bool => _run_mode == CompilerRunMode.GHUL_CLI

        // The target a ghul-cli test is built for, or null for each
        // project's first.
        project_target: string? public

        // The command that runs ghul-cli: `ghul` unless the run names another,
        // such as `dotnet ghul` for a local tool. Words are split on spaces.
        set_ghul_command(command: string?) is
            if command? /\ !string.is_null_or_white_space(command) then
                _executable = command
            fi
        si

        runtime_path: string => _runtime_path

        set_runtime_path(path: string?) is
            if !path? \/ string.is_null_or_white_space(path) then
                return
            fi

            if !File.exists(path) then
                throw Exception("runtime DLL not found: {path}")
            fi

            _runtime_path = Path.get_full_path(path)
        si

        // The command `dotnet build` runs to compile a test project, handed to
        // MSBuild as the `GhulCompiler` property. Null means the property is
        // left alone, so the project's own default applies -- for a project
        // using the ghul.runtime targets, `dotnet ghul-compiler` from the local
        // tool manifest.
        compiler_command: string? => _compiler_command

        set_compiler_command(command: string?) is
            if !command? \/ string.is_null_or_white_space(command) then
                return
            fi

            if _run_mode != CompilerRunMode.DOTNET then
                throw Exception("a compiler command can only be set for --use-dotnet-build runs")
            fi

            let trimmed = command.trim()

            // A bare path is checked; anything with arguments in it (say
            // `dotnet /path/to/ghul.dll`) is passed through as written.
            if !trimmed.contains(" ") /\ !File.exists(trimmed) then
                throw Exception("compiler not found: {trimmed}")
            fi

            _compiler_command = trimmed
        si

        // With no `-a` the compiler defaults to the SDK reference pack plus
        // the runtime bundled beside the compiler being tested - whatever was
        // current when that compiler was published, not the runtime a test
        // runs against. Any `-a` opts out of that default entirely, so naming
        // the pinned runtime as a reference means naming the whole pack as
        // well.
        reference_arguments() -> Iterable[string] is
            let arguments = LIST[string]()

            let pack_dlls = Directory.get_files(_sdk_reference_path, "*.dll") |>
                sort() |>
                collect_list()

            for dll in pack_dlls do
                arguments.add("-a")
                arguments.add(dll)
            od

            arguments.add("-a")
            arguments.add(_runtime_path)

            return arguments
        si

        // A `publish` directory at or above the working directory is where the
        // compiler being tested is published to, so prefer it over whatever the
        // local tool manifest happens to pin.
        discover_compiler_command() -> string? is
            let publish = try_find_publish_directory(DirectoryInfo(Directory.get_current_directory()))

            if !publish? then
                return null
            fi

            return try_find_published_compiler(publish)
        si

        run_compiler(runner: RUNNER, test: TEST) -> bool is
            let arguments = LIST[string]()

            arguments.add_range(_arguments)

            if test.flags.length > 0 then
                arguments.add_range(
                    test.flags.split([' ']) |> map((flag) -> string => flag.trim())
                )
            fi

            let result mut = -1

            if _run_mode == CompilerRunMode.GHUL_CLI then
                // ghul-cli writes its own messages to standard error and the
                // compiler's to standard output: the shell merges the two in
                // the order they are written, which two capture files would
                // lose.
                let command = LIST[string](["-c", "exec \"$0\" \"$@\" 2>&1"])

                command.add_range(_executable.split([' ']) |> filter(word => word.length > 0))
                command.add("build")

                command.add_range(["--target", test.project!.target])
                command.add_range(arguments |> skip(1))

                result = runner.run(
                    "sh",
                    command,
                    RUNNER.BUILD_TIMEOUT_MS,
                    "compiler.out",
                    null
                )
            elif _run_mode == CompilerRunMode.DOTNET then
                if _compiler_command? then
                    // MSBuild reads environment variables as properties, so
                    // this sets `GhulCompiler` for the build. Passing it on the
                    // command line instead would not survive a value containing
                    // spaces.
                    result = runner.run(
                        _executable,
                        arguments,
                        RUNNER.BUILD_TIMEOUT_MS,
                        "compiler.out", // MSBuild coerces stderr output to stdout
                        null,
                        [Pair[string, string]("GhulCompiler", _compiler_command)]
                    )
                else
                    result = runner.run(
                        _executable,
                        arguments,
                        RUNNER.BUILD_TIMEOUT_MS,
                        "compiler.out", // MSBuild coerces stderr output to stdout
                        null
                    )
                fi
            else
                arguments.add_range(reference_arguments())
                arguments.add_range(test.source_files)
                arguments.add_range(["-o", "binary.exe"])

                result = runner.run(
                    _executable,
                    arguments,
                    RUNNER.BUILD_TIMEOUT_MS,
                    null,
                    "compiler.out"
                )
            fi

            if !File.exists(runner.get_path("compiler.out")) then
                throw Exception("compiler output file not found")
            fi

            if result != 0 then
                return false
            fi

            if _run_mode != CompilerRunMode.DOTNET /\ _run_mode != CompilerRunMode.GHUL_CLI /\ !runner.read_all_text("compiler.out").contains("*** succeeded ***") then
                throw Exception("compiler success exit status but success message not found in output")
            fi

            // FIXME: this is a bit convoluted:
            return File.exists(get_binary_path(runner))
        si

        // Format the test's sources, in place, over the copies the runner
        // made in the test's `formatted` directory. The formatter reads
        // and writes source and emits nothing, so this is a separate
        // invocation from the build rather than a flag on it.
        run_formatter(runner: RUNNER, test: TEST, sources: Iterable[string]) -> bool is
            let arguments = LIST[string]()

            arguments.add_range(_arguments)

            // The same flags the two builds get: a flag that changes how the
            // compiler reads a file - `--global-namespace`, say - changes
            // what the formatter reads too, and a test that needs one in its
            // `ghulflags` means it for all three invocations.
            if test.flags.length > 0 then
                arguments.add_range(
                    test.flags.split([' ']) |> map((flag) -> string => flag.trim())
                )
            fi

            arguments.add_range(reference_arguments())
            arguments.add("--format-in-place")
            arguments.add_range(sources)

            let result =
                runner.run(
                    _executable,
                    arguments,
                    RUNNER.BUILD_TIMEOUT_MS,
                    null,
                    "format.err"
                )

            return result == 0
        si

        // Build the formatted sources into their own binary, so the
        // original one is still there to compare against.
        build_formatted(runner: RUNNER, test: TEST, sources: Iterable[string]) -> bool is
            let arguments = LIST[string]()

            arguments.add_range(_arguments)

            if test.flags.length > 0 then
                arguments.add_range(
                    test.flags.split([' ']) |> map((flag) -> string => flag.trim())
                )
            fi

            arguments.add_range(reference_arguments())
            arguments.add_range(sources)
            arguments.add_range(["-o", FORMATTED_BINARY])

            let result =
                runner.run(
                    _executable,
                    arguments,
                    RUNNER.BUILD_TIMEOUT_MS,
                    null,
                    "formatted-compiler.out"
                )

            return result == 0 /\ File.exists(runner.get_path(FORMATTED_BINARY))
        si

        FORMATTED_BINARY: string static => "formatted.exe"

        get_binary_path_relative_to_test_folder(runner: RUNNER) -> string is
            if let project = runner.project then
                return project.binary_path_relative_to_test_folder
            fi

            if _run_mode == CompilerRunMode.DOTNET then
                return Path.join(["bin", "Debug", get_target_framework(), "binary.dll"])
            fi

            return "binary.exe"
        si

        get_binary_path(runner: RUNNER) -> string is
            if let project = runner.project then
                return runner.get_path(project.binary_path_relative_to_test_folder)
            fi

            if _run_mode == CompilerRunMode.DOTNET then
                return Path.join([runner.get_path(), "bin", "Debug", get_target_framework(), "binary.dll"])
            fi

            return runner.get_path("binary.exe")
        si

        run_ln_runtime(runner: RUNNER) -> bool is
            if _run_mode == CompilerRunMode.DOTNET \/ _run_mode == CompilerRunMode.GHUL_CLI then
                return true
            fi

            return runner.run(
                "ln",
                ["-s", _runtime_path, "."],
                RUNNER.TOOL_TIMEOUT_MS,
                null,
                null
            ) != 0
        si

        find_publish_directory() -> string is
            let result = try_find_publish_directory(DirectoryInfo(Directory.get_current_directory()))

            if !result? then
                throw Exception("could not find a publish directory")
            fi

            return result
        si

        try_find_publish_directory(from: DirectoryInfo?) -> string? is
            if !from? then
                return null
            fi

            let publish = from.get_directories("publish") |> first()

            if publish? then
                return publish.full_name
            fi

            return try_find_publish_directory(from.parent)
        si

        find_published_compiler() -> string is
            let result = try_find_published_compiler(_publish)

            if !result? then
                throw Exception("Could not find published compiler: {get_published_compiler_path("[ghul|ghul.exe]")}")
            fi

            return result
        si

        try_find_published_compiler(publish: string) -> string? is
            for name in ["ghul", "ghul.exe"] do
                let candidate = Path.join(publish, name)

                if File.exists(candidate) then
                    return candidate
                fi
            od

            return null
        si

        get_published_compiler_path(file_name: string) -> string =>
            Path.join(_publish, file_name)

        get_ghul_test_runtime_path() -> string is
            let executing_assembly = System.Reflection.Assembly.get_executing_assembly()

            let assembly_path = Path.get_full_path(executing_assembly.location)

            let result = Path.get_directory_name(assembly_path)

            return Path.join(result, "ghul-runtime.dll")
        si

        // Locate the .NET reference-assembly directory to hand the compiler.
        // The target framework follows what this harness was *built* for, not
        // the runtime it rolls forward onto — the compiler and the test outputs
        // target that framework, so an ecosystem-wide bump needs no change here.
        // The install root comes from `dotnet --list-sdks`, and we take the
        // highest ref pack matching the target framework's version.
        discover_sdk_reference_path() -> string is
            let target_framework = get_target_framework()
            // "net10.0" -> "10.0", to match ref-pack directory names like "10.0.8".
            let framework_version = target_framework.substring(3, target_framework.length - 3)

            let dotnet_root = find_dotnet_root()
            let packs_root = Path.join([dotnet_root, "packs", "Microsoft.NETCore.App.Ref"])

            if !Directory.exists(packs_root) then
                throw Exception("no .NET reference assembly packs found at {packs_root}")
            fi

            let pack = find_latest_ref_pack(packs_root, framework_version)

            if !pack? then
                throw Exception("no Microsoft.NETCore.App.Ref pack matching {framework_version}.* under {packs_root}")
            fi

            let reference_path = Path.join([pack, "ref", target_framework])

            if !Directory.exists(reference_path) then
                throw Exception("reference assemblies not found at {reference_path}")
            fi

            return reference_path
        si

        // The target framework this harness was built for (e.g. "net10.0"),
        // read from the `tfm` field of its runtimeconfig.json. This is the
        // framework the compiler and test outputs target, independent of the
        // runtime we roll forward onto, so an ecosystem-wide bump needs no
        // change here.
        get_target_framework() -> string is
            let assembly = System.Reflection.Assembly.get_executing_assembly()
            let assembly_path = Path.get_full_path(assembly.location)
            let directory = Path.get_directory_name(assembly_path)
            let name = Path.get_file_name_without_extension(assembly_path)
            let config_path = Path.join(directory, "{name}.runtimeconfig.json")

            if !File.exists(config_path) then
                throw Exception("runtime config not found at {config_path}")
            fi

            let target_framework = extract_json_string(File.read_all_text(config_path), "tfm")

            if !target_framework? then
                throw Exception("no \"tfm\" entry found in {config_path}")
            fi

            return target_framework
        si

        // Minimal extractor for a string-valued key in flat JSON; enough for
        // the fixed shape of runtimeconfig.json (no nested escaping in `tfm`).
        extract_json_string(content: string, key: string) -> string? is
            let key_index = content.index_of("\"{key}\"")

            if key_index < 0 then
                return null
            fi

            let colon = content.index_of(':', key_index)
            let open = if colon >= 0 then content.index_of('"', colon) else -1 fi
            let close = if open >= 0 then content.index_of('"', open + 1) else -1 fi

            if close < 0 then
                return null
            fi

            return content.substring(open + 1, close - open - 1)
        si

        find_dotnet_root() -> string is
            let output = run_and_capture("dotnet", ["--list-sdks"])

            for line in output.split(['\n']) do
                let trimmed = line.trim()
                let open = trimmed.index_of('[')
                let close = trimmed.last_index_of(']')

                if open >= 0 /\ close > open then
                    // `dotnet --list-sdks` prints `<version> [<root>/sdk]`.
                    let sdk_directory = trimmed.substring(open + 1, close - open - 1).trim()
                    let root = Path.get_directory_name(sdk_directory)

                    if root? /\ Directory.exists(root) then
                        return root
                    fi
                fi
            od

            throw Exception("could not determine the .NET install root from `dotnet --list-sdks`")
        si

        find_latest_ref_pack(packs_root: string, framework_version: string) -> string? is
            let best: string? mut = null
            let best_version: System.Version? mut = null

            for directory in Directory.get_directories(packs_root, "{framework_version}.*") do
                let version = try_parse_version(Path.get_file_name(directory))

                if version? /\ (!best_version? \/ version.compare_to(best_version) > 0) then
                    best_version = version
                    best = directory
                fi
            od

            return best
        si

        try_parse_version(text: string?) -> System.Version? is
            if !text? then
                return null
            fi

            try
                return System.Version.parse(text)
            catch ex: Exception
                return null
            yrt
        si

        run_and_capture(path: string, arguments: Iterable[string]) -> string is
            let start_info = System.Diagnostics.ProcessStartInfo()

            start_info.file_name = path
            start_info.arguments = arguments |> join(" ")
            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            let process = System.Diagnostics.Process.start(start_info)

            if !process? then
                throw Exception("failed to start `{path}`")
            fi

            let output = process.standard_output.read_to_end()

            process.wait_for_exit(RUNNER.TOOL_TIMEOUT_MS)

            return output
        si
    si
si
