namespace Tester is
    use Ghul.Exception

    use IO.Std
    use IO.Directory
    use IO.File
    use IO.Path

    use Collections.Iterable
    use Ghul.Pipes
    use Collections.MutableList
    use Collections.LIST

    class TEST_QUEUE(
        host_cli: string private,
        target_cli: string private,
        wasm_host_cli: string? private,
        compiler_under_test: COMPILER_UNDER_TEST private,
        disassembler: DISASSEMBLER private,
        progress_reporter: PROGRESS_REPORTER private,
        tag_filter: TAG_FILTER private,
        shard: SHARD private,
        target_flags: Collections.Map[string, string] private,
        processes: int? private
    ) is
        _task_queue: TASK_QUEUE

        _tests: MutableList[TEST]

        // Why directories that look like a test were not run: a `test.ghul`
        // or an expected snapshot without the file that makes a directory a
        // test, or a project whose manifest cannot be tested. Nothing would
        // run them, so they are reported rather than passed over.
        _undiscovered: MutableList[string]

        undiscovered: Iterable[string] => _undiscovered
        undiscovered_count: int => _undiscovered.count

        /// The targets the run covers, or null for every target. A test, or a
        /// variant of one, built for another target is passed over.
        run_targets: Collections.List[TestTarget]? public

        /// How many tests and variants were passed over for a target the run
        /// does not cover.
        passed_over_count: int

        /// How many tests the tag filter left out.
        filtered_out_count: int

        /// How many tests are not built for a target the configuration's
        /// `build_targets` names, because their own `build_targets` leave it
        /// out.
        left_out_target_count: int

        // Why variants were passed over other than for the run's targets.
        _passed_over_reasons: MutableList[string]

        /// The targets each test is built for, one variant each, or null to
        /// build each test once for the target it names.
        build_targets: Collections.List[string]? public

        /// The settings the configuration makes for every test, which a
        /// test's own `test.json` overrides key by key.
        run_settings: TEST_SETTINGS? public

        /// For each target, the flags of each library that stands for a
        /// package, keyed by the package in lower case.
        package_flags: Collections.Map[string, Collections.MAP[string, string]] public,
            = value is _package_flags = value si

        _package_flags: Collections.Map[string, Collections.MAP[string, string]]

        /// For each target, the loader its wasm builds are given where a
        /// test doesn't name one itself.
        target_loaders: Collections.Map[string, string] public

        _covers(target: TestTarget) -> bool =>
            if let targets = run_targets then targets |> any(t => t == target) else true fi

        // Counts every test that survives the tag filter, so a shard
        // selects the same tests however the run is divided.
        _candidate_ordinal: int

        progress: int
        count: int => _tests.count

        // How many tests the run would hold were it not sharded. Summing this
        // across the shards of a run shows none was dropped.
        candidate_count: int => _candidate_ordinal

        executed_count: int => _tests |> filter(t => t.has_executed) |> Ghul.Pipes.count()
        pass_count: int => _tests |> filter(t => t.has_passed) |> Ghul.Pipes.count()
        fail_count: int => _tests |> filter(t => t.has_failed) |> Ghul.Pipes.count()

        init(..) is
            let requested_test_processes = System.Environment.get_environment_variable("TEST_PROCESSES")

            let actual_test_processes: int mut

            if requested_test_processes? then
                actual_test_processes = System.Convert.to_int32(requested_test_processes)
            elif let configured = _processes then
                actual_test_processes = configured
            else
                let cpu_count = System.Environment.processor_count

                if cpu_count <= 6 then
                    actual_test_processes = cpu_count * 2
                else
                    actual_test_processes = cpu_count * 3 / 2
                fi
            fi

            _task_queue = TASK_QUEUE(actual_test_processes)

            _compiler_under_test.start_fork_servers(actual_test_processes)

            Std.write_line("using {actual_test_processes} processes to run tests")

            _tests = LIST[TEST]()
            _undiscovered = LIST[string]()
            _passed_over_reasons = LIST[string]()
            _package_flags = Collections.MAP[string, Collections.MAP[string, string]]()
            target_loaders = Collections.MAP[string, string]()
        si

        run_queued_tests() is
            _progress_reporter.on_discovered(count)

            report_missing_disassembler()
            report_direct_builds()
            report_passed_over()

            for test in _tests do
                let runner =
                    RUNNER(
                        _host_cli,
                        _target_cli,
                        _wasm_host_cli,
                        _compiler_under_test,
                        _disassembler,
                        test
                    )

                let results = _task_queue.queue(runner.get_run())

                report_progress(results)

                // `queue` returns once the task is running, so this reports a
                // test that has actually started, not one waiting for a slot.
                _progress_reporter.on_start(test.name)
            od

            let results mut = _task_queue.drain()

            while results? do
                report_progress(results)
                results = _task_queue.drain()
            od

            _progress_reporter.close()
        si

        report_progress(results: Iterable[Result]) is
            for result in results do
                let p = 100 * progress / count

                result.progress = p

                Std.write_line(result)

                progress = progress + 1

                _progress_reporter.on_finish(result)
            od
        si

        try_queue_tests(path: string) is
            try
                try_queue_test(path)

                let entries = LIST[string](Directory.get_directories(path))

                entries.sort()

                for entry in entries do
                    // A directory whose name starts with a dot holds something
                    // about a test rather than a test: the per-target
                    // directories of one run under several targets.
                    if Path.get_file_name(entry)!.starts_with(".") then
                        continue
                    fi

                    // A test's formatted/ holds the formatter's output from a
                    // run, not a test.
                    if Path.get_file_name(entry)! =~ "formatted" /\ TEST_SETTINGS.has(path) then
                        continue
                    fi

                    try_queue_tests(entry)
                od
            catch ex: Exception
                Std.write_line("probably not a directory: {path}")
                Std.write_line("caught: {ex}")
            yrt
        si

        try_queue_test(path: string) is
            let has_settings = TEST_SETTINGS.has(path)

            // ghul-test 11 stopped reading these: a test that still has one
            // is reported rather than silently left out or run without them.
            for retired in ["ghulflags", "targets"] do
                if File.exists(Path.join(path, retired)) then
                    let replacement = if retired =~ "ghulflags" then "flags" else "build_targets" fi

                    _undiscovered.add("{path} has a {retired} file, which is no longer read; put its contents in the {replacement} of a {TEST_SETTINGS.FILE}")
                    return
                fi
            od

            let marker = if _compiler_under_test.is_ghul_cli then PROJECT.MANIFEST else TEST_SETTINGS.FILE fi

            if !File.exists(Path.join(path, marker)) /\ !has_settings then
                if looks_like_test(path) then
                    _undiscovered.add("{path} looks like a test but has no {marker}")
                fi

                return
            fi

            let project: PROJECT? mut = null

            if _compiler_under_test.is_ghul_cli then
                let problem: string? mut = null

                project = PROJECT.read(path, _compiler_under_test.project_target, problem ref)

                if let reason = problem then
                    _undiscovered.add("{path}: {reason}")
                    return
                fi

                if !project? then
                    return
                fi
            fi

            let tags = get_tags(path)

            if !_tag_filter.matches(tags) then
                filtered_out_count = filtered_out_count + 1
                return
            fi

            let own: TEST_SETTINGS? mut = null

            if has_settings then
                let problem: string? mut = null

                own = TEST_SETTINGS.read(path, problem ref)

                if !own? then
                    _undiscovered.add("{path}: {problem}")
                    return
                fi
            fi

            let settings = (run_settings ?? TEST_SETTINGS()).overridden_by(own)
            let flags = settings.options.trim()

            // A test whose flags name its target is run in place under
            // build_targets, as it is without them: it is built for that one
            // target either way, and a copy would move it away from files it
            // names relative to itself.
            if own?.build_targets? \/ (build_targets? /\ !TEST.named_target_name(flags)?) then
                let problem: string? mut = null

                let targets = variant_targets(path, flags, own?.build_targets, problem ref)

                if !targets? then
                    _undiscovered.add("{path}: {problem}")
                    return
                fi

                let variant_ordinal = _candidate_ordinal

                _candidate_ordinal = _candidate_ordinal + 1

                if _shard.matches(variant_ordinal) then
                    queue_variants(path, flags, tags, targets, settings)
                fi

                return
            fi

            // A test that was run as variants before and is not now: the
            // copies would otherwise be read as its sources by a build that
            // globs the test directory.
            let stale_variants = Path.join(path, TARGET_VARIANTS.DIRECTORY)

            if Directory.exists(stale_variants) then
                Directory.delete(stale_variants, true)
            fi

            if !_covers(project?.test_target ?? TEST.named_target(flags) ?? TestTarget.DOTNET) then
                passed_over_count = passed_over_count + 1
                return
            fi

            let ordinal = _candidate_ordinal

            _candidate_ordinal = _candidate_ordinal + 1

            if !_shard.matches(ordinal) then
                return
            fi

            let source_files = get_source_files(path)
            let is_build_failure_expected = File.exists("{path}/fail.expected")

            let test =
                TEST(
                    path,
                    source_files,
                    "{with_loader(flags)}{last_options(settings, TEST.named_target_name(flags))}",
                    is_build_failure_expected,
                    tags
                )

            test.project = project

            if _compiler_under_test.build_directly /\ flags.trim().length == 0 then
                let problem: string? mut = null

                test.direct = DIRECT_BUILD.read(path, _target_framework, problem ref)
                test.direct_problem = problem
            fi

            queue_test(test)
        si

        // A compiler build's flags with the loader the configuration gives
        // the target they name, unless they name a loader themselves. Only
        // a test built once needs this: a variant's flags carry the target's
        // library lines, the loader among them.
        with_loader(flags: string) -> string is
            if _compiler_under_test.is_dotnet_build \/ _compiler_under_test.is_ghul_cli then
                return flags
            fi

            if let target = TEST.named_target_name(flags) then
                if target_loaders.contains_key(target) /\ !(flags.split([' ', '\t', '\r', '\n']) |> any(w => w =~ "--wasm-loader")) then
                    return "{flags.trim()} --wasm-loader {target_loaders[target]}"
                fi
            fi

            return flags
        si

        // The flags the configuration gives runs under `target`, with a
        // leading space so they append to a command line, or nothing.
        extra_flags(target: string) -> string =>
            if _target_flags.contains_key(target) then " {_target_flags[target]}" else "" fi

        looks_like_test(path: string) -> bool =>
            File.exists("{path}/test.ghul") \/
            Directory.get_files(path, "*.expected").count > 0

        // How many of the run's tests are built without MSBuild, where the
        // run asked for that: the rest are built with `dotnet build`.
        report_direct_builds() is
            if !_compiler_under_test.build_directly then
                return
            fi

            let direct = _tests |> filter(test => test.direct?) |> Ghul.Pipes.count()

            Std.write_line("building {direct} of {_tests.count} test(s) directly, the rest with dotnet build")

            let reasons =
                _tests
                    |> filter(test => test.direct_problem?)
                    |> map(test => test.direct_problem!)
                    |> LIST()

            for reason in reasons |> Ghul.Pipes.distinct() do
                Std.write_line("  with dotnet build: {reasons |> Ghul.Pipes.count(r => r =~ reason)} for {reason}")
            od
        si

        _target_framework: string =>
            _known_target_framework ?? _remember_target_framework()

        _known_target_framework: string?

        _remember_target_framework() -> string is
            let result = _compiler_under_test.target_framework

            _known_target_framework = result

            return result
        si

        // Asked once for the whole run rather than per test: whether a
        // disassembler was found cannot change while tests are running,
        // and every test wanting IL would otherwise say so separately,
        // from tasks running at the same time.
        report_missing_disassembler() is
            if _disassembler.is_available then
                return
            fi

            let wanted =
                _tests |> filter(test => File.exists("{test.path}/il.expected")) |> Ghul.Pipes.count()

            if wanted == 0 then
                return
            fi

            Std.write_line(
                "{wanted} test(s) expect IL but no disassembler was found: "
                "set GHUL_TEST_ILDASM, or name ildasm in the configuration")
        si

        queue_test(test: TEST) is
            _tests.add(test)
        si

        // The targets the test at `path` is built for, one variant each: the
        // ones its settings' `build_targets` name, or else the
        // configuration's `build_targets`. Null, with the reason in
        // `problem`, where the test's own `build_targets` cannot be used.
        variant_targets(path: string, flags: string, settings_targets: Collections.List[string]?, problem: string? ref) -> Collections.List[string]? is
            problem! = null

            if let named = settings_targets then
                if TEST.named_target(flags)? then
                    problem! = "{TEST_SETTINGS.FILE} names build_targets and its flags name a target too; a test with build_targets leaves the target to them"
                    return null
                fi

                if let wanted = build_targets /\ wanted |> any(target => !(named |> any(n => n =~ target))) then
                    left_out_target_count = left_out_target_count + 1
                fi

                return named
            fi

            return build_targets
        si

        // One test for each of `targets`, each in its own directory with the
        // expectations resolved for that target. The tags are the one test's,
        // and so is the shard ordinal, so a shard holds every variant or none.
        queue_variants(path: string, flags: string, tags: Iterable[string], targets: Collections.List[string], settings: TEST_SETTINGS) is
            for target in targets do
                let test_target = TEST_TARGETS.of(target) ?? TestTarget.DOTNET

                if !_covers(test_target) then
                    passed_over_count = passed_over_count + 1
                    continue
                fi

                let project: PROJECT? mut = null

                if _compiler_under_test.is_ghul_cli then
                    let problem: string? mut = null

                    project = PROJECT.read(path, target, problem ref)

                    if let reason = problem then
                        _undiscovered.add("{path}: {reason}")
                        return
                    fi

                    if !project? then
                        pass_over("the project does not list the target")
                        continue
                    fi
                fi

                let directory = TARGET_VARIANTS.materialize(path, target, _compiler_under_test.is_dotnet_build \/ _compiler_under_test.is_ghul_cli)

                let test =
                    TEST(
                        directory,
                        get_source_files(directory),
                        "{variant_flags(flags, target)}{last_options(settings, target)}",
                        File.exists("{directory}/fail.expected"),
                        tags
                    )

                test.name = "{path}[{target}]"
                test.build_target = test_target
                test.project = project

                if _compiler_under_test.is_dotnet_build then
                    if test_target == TestTarget.DOTNET then
                        if _compiler_under_test.build_directly /\ flags.trim().length == 0 then
                            let problem: string? mut = null

                            test.direct = DIRECT_BUILD.read(directory, _target_framework, problem ref)
                            test.direct_problem = problem
                        fi
                    elif flags.trim().length > 0 then
                        pass_over("its flags are not empty, so only MSBuild can build it")
                        continue
                    else
                        let problem: string? mut = null

                        let direct = DIRECT_BUILD.read(directory, _target_framework, target, known_packages(target), problem ref)

                        if !direct? then
                            pass_over(problem ?? "it cannot be built directly")
                            continue
                        fi

                        direct.target_options.add_range(["--target", target])
                        direct.target_options.add_range(_words(extra_flags(target)))
                        direct.target_options.add_range(_words(settings.last_options(target)))

                        for package in direct.packages do
                            direct.target_options.add_range(_words(_package_flags[target][package]))
                        od

                        test.direct = direct
                    fi
                fi

                queue_test(test)
            od
        si

        // The flags a variant is built with. A compiler build is told the
        // target and given the configuration's flags for it; a project build
        // takes the target from the project, from the build kind, or from
        // what the runner hands a direct build.
        variant_flags(flags: string, target: string) -> string =>
            if _compiler_under_test.is_dotnet_build \/ _compiler_under_test.is_ghul_cli then
                flags
            elif TEST.named_target(flags)? then
                "{flags.trim()}{extra_flags(target)}"
            else
                "{flags.trim()} --target {target}{extra_flags(target)}"
            fi

        // The options a compiler build of `target` takes after all the
        // others, so the compiler takes them over any the configuration
        // gives. A project build's flags are its builder's, not the
        // compiler's, and a direct one is given them with the target's.
        last_options(settings: TEST_SETTINGS, target: string?) -> string =>
            if _compiler_under_test.is_dotnet_build \/ _compiler_under_test.is_ghul_cli then
                ""
            else
                settings.last_options(target)
            fi

        // The packages, in lower case, a library stands for under `target`.
        known_packages(target: string) -> Collections.Set[string] =>
            if _package_flags.contains_key(target) then
                _package_flags[target].keys |> Collections.SET()
            else
                Collections.SET[string]()
            fi

        // A variant that cannot be built for its target in this run: counted
        // with the others passed over, and its reason reported once.
        pass_over(reason: string) is
            passed_over_count = passed_over_count + 1
            _passed_over_reasons.add(reason)
        si

        // Why variants were passed over for a reason other than the run's
        // targets, once each with how many. A test whose own build_targets
        // leave out a target the configuration builds is not one of them:
        // that is how a test says the target is not its point, so it is only
        // counted.
        report_passed_over() is
            for reason in _passed_over_reasons |> Ghul.Pipes.distinct() do
                Std.write_line("passed over {_passed_over_reasons |> Ghul.Pipes.count(r => r =~ reason)} variant(s): {reason}")
            od
        si

        _words(text: string) -> Iterable[string] =>
            text.split([' ', '\t', '\r', '\n']) |> filter(word => word.length > 0) |> ARRAY()

        get_source_files(path: string) -> Iterable[string] =>
            Directory.get_files(path, "*.ghul")
                |> map(path: string => Path.get_file_name(path)!)

        get_tags(path: string) -> Iterable[string] is
            let tags_path = "{path}/tags"

            if !File.exists(tags_path) then
                return LIST[string]()
            fi

            return TAG_FILTER.parse_tags(File.read_all_text(tags_path)) |> LIST()
        si
    si
si
