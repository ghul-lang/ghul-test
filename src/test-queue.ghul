namespace Tester is
    use System.Exception

    use IO.Std
    use IO.Directory
    use IO.File
    use IO.Path

    use Collections.Iterable
    use Ghul.Pipes
    use Collections.MutableList
    use Collections.LIST

    class TEST_QUEUE(
        host_cli: string private,
        target_cli: string private,
        compiler_under_test: COMPILER_UNDER_TEST private,
        disassembler: DISASSEMBLER private,
        progress_reporter: PROGRESS_REPORTER private,
        tag_filter: TAG_FILTER private,
        shard: SHARD private
    ) is
        _task_queue: TASK_QUEUE

        _tests: MutableList[TEST]

        // Why directories that look like a test were not run: a `test.ghul`
        // or an expected snapshot without the file that makes a directory a
        // test, or a project whose manifest cannot be tested. Nothing would
        // run them, so they are reported rather than passed over.
        _undiscovered: MutableList[string]

        undiscovered: Iterable[string] => _undiscovered
        undiscovered_count: int => _undiscovered.count

        // Counts every test that survives the tag filter, so a shard
        // selects the same tests however the run is divided.
        _candidate_ordinal: int

        progress: int
        count: int => _tests.count

        // How many tests the run would hold were it not sharded. Summing this
        // across the shards of a run shows none was dropped.
        candidate_count: int => _candidate_ordinal

        executed_count: int => _tests |> filter(t => t.has_executed) |> Ghul.Pipes.count()
        pass_count: int => _tests |> filter(t => t.has_passed) |> Ghul.Pipes.count()
        fail_count: int => _tests |> filter(t => t.has_failed) |> Ghul.Pipes.count()

        init(..) is
            let requested_test_processes = System.Environment.get_environment_variable("TEST_PROCESSES")

            let actual_test_processes: int mut

            if requested_test_processes? then
                actual_test_processes = System.Convert.to_int32(requested_test_processes)
            else
                let cpu_count = System.Environment.processor_count

                if cpu_count <= 6 then
                    actual_test_processes = cpu_count * 2
                else
                    actual_test_processes = cpu_count * 3 / 2
                fi
            fi

            _task_queue = TASK_QUEUE(actual_test_processes)

            Std.write_line("using {actual_test_processes} processes to run tests")

            _tests = LIST[TEST]()
            _undiscovered = LIST[string]()
        si

        run_queued_tests() is
            _progress_reporter.on_discovered(count)

            report_missing_disassembler()

            for test in _tests do
                let runner =
                    RUNNER(
                        _host_cli,
                        _target_cli,
                        _compiler_under_test,
                        _disassembler,
                        test
                    )

                let results = _task_queue.queue(runner.get_run())

                report_progress(results)

                // `queue` returns once the task is running, so this reports a
                // test that has actually started, not one waiting for a slot.
                _progress_reporter.on_start(test.path)
            od

            let results mut = _task_queue.drain()

            while results? do
                report_progress(results)
                results = _task_queue.drain()
            od

            _progress_reporter.close()
        si

        report_progress(results: Iterable[Result]) is
            for result in results do
                let p = 100 * progress / count

                result.progress = p

                Std.write_line(result)

                progress = progress + 1

                _progress_reporter.on_finish(result)
            od
        si

        try_queue_tests(path: string) is
            try
                try_queue_test(path)

                let entries = LIST[string](Directory.get_directories(path))

                entries.sort()

                for entry in entries do
                    // FIXME: appears not to be needed:
                    if entry =~ "." \/ entry =~ ".." \/ entry =~ "template" then
                        continue
                    fi

                    try_queue_tests(entry)
                od
            catch ex: Exception
                Std.write_line("probably not a directory: {path}")
                Std.write_line("caught: {ex}")
            yrt
        si

        try_queue_test(path: string) is
            let flags_path = "{path}/ghulflags"
            let marker = if _compiler_under_test.is_ghul_cli then PROJECT.MANIFEST else "ghulflags" fi

            if !File.exists("{path}/{marker}") then
                if looks_like_test(path) then
                    _undiscovered.add("{path} looks like a test but has no {marker}")
                fi

                return
            fi

            let project: PROJECT? mut = null

            if _compiler_under_test.is_ghul_cli then
                let problem: string? mut = null

                project = PROJECT.read(path, _compiler_under_test.project_target, problem ref)

                if let reason = problem then
                    _undiscovered.add("{path}: {reason}")
                    return
                fi

                if !project? then
                    return
                fi
            fi

            let tags = get_tags(path)

            if !_tag_filter.matches(tags) then
                return
            fi

            let ordinal = _candidate_ordinal

            _candidate_ordinal = _candidate_ordinal + 1

            if !_shard.matches(ordinal) then
                return
            fi

            let flags = if File.exists(flags_path) then File.read_all_text(flags_path) else "" fi
            let source_files = get_source_files(path)
            let is_build_failure_expected = File.exists("{path}/fail.expected")

            let test =
                TEST(
                    path,
                    source_files,
                    flags,
                    is_build_failure_expected,
                    tags
                )

            test.project = project

            queue_test(test)
        si

        looks_like_test(path: string) -> bool =>
            File.exists("{path}/test.ghul") \/
            Directory.get_files(path, "*.expected").count > 0

        // Asked once for the whole run rather than per test: whether a
        // disassembler was found cannot change while tests are running,
        // and every test wanting IL would otherwise say so separately,
        // from tasks running at the same time.
        report_missing_disassembler() is
            if _disassembler.is_available then
                return
            fi

            let wanted =
                _tests |> filter(test => File.exists("{test.path}/il.expected")) |> Ghul.Pipes.count()

            if wanted == 0 then
                return
            fi

            Std.write_line(
                "{wanted} test(s) expect IL but no disassembler was found: "
                "set GHUL_TEST_ILDASM, or pass --ildasm <path>")
        si

        queue_test(test: TEST) is
            _tests.add(test)
        si

        get_source_files(path: string) -> Iterable[string] =>
            Directory.get_files(path, "*.ghul")
                |> map(path: string => Path.get_file_name(path)!)

        get_tags(path: string) -> Iterable[string] is
            let tags_path = "{path}/tags"

            if !File.exists(tags_path) then
                return LIST[string]()
            fi

            return TAG_FILTER.parse_tags(File.read_all_text(tags_path)) |> collect_list()
        si
    si
si
