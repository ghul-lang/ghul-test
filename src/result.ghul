namespace Tester is
    use System.Text.StringBuilder

    use IO.Std

    use Collections.Iterable
    use Ghul.Pipes
    use Collections.MutableList
    use Collections.LIST

    class Result abstract is
        test: TEST

        _progress: int
        progress: int public => _progress, = value is
            if value < 0 then
                _progress = 0
            elif value > 100 then
                _progress = 100
            else
                _progress = value
            fi
        si

        // How long the test's program took to run and to say anything, null
        // for a test that ran no program. Set by the runner once the program
        // has finished, read by whatever reports the result.
        timing: TIMING? public

        progress_string: string => "{progress.to_string().pad_left(2)}%"

        is_pass: bool is
            throw System.NotImplementedException()
        si

        is_fail: bool is
            throw System.NotImplementedException()
        si

        is_executed: bool => is_pass \/ is_fail

        head: string is
            throw System.NotImplementedException()
        si

        body: string? => null

        init(test: TEST) is
            self.test = test
            test.result = self
        si

        format(test_name: string) -> string is
            let result mut = "{progress_string} {head}: {test_name}"

            if body? /\ body !~ "" then
                result = "{result}: {body}"
            fi

            return result
        si

        to_string() -> string => format(test.path)
    si

    class SKIP: Result is
        is_pass: bool => false
        is_fail: bool => false
        head: string => "   skip"

        init(test: TEST) is super.init(test); si
    si

    class PASS: Result is
        is_pass: bool => true
        is_fail: bool => false
        head: string => "✅ pass"

        init(test: TEST) is super.init(test); si
    si

    class FAILURE: Result is
        _details: MutableList[DETAILS]

        is_pass: bool => false
        is_fail: bool => true
        head: string => "❌ fail"

        body: string? is
            if _details.count == 0 then
                return null
            elif _details.count == 1 then
                return _details[0].to_string()
            else
                return _details |> join("\n")
            fi
        si

        init(test: TEST) is
            super.init(test)
            _details = LIST[DETAILS]()
        si

        init(test: TEST, details: DETAILS) is
            init(test)
            add(details)
        si

        init(test: TEST, message: string) is
            init(test, DETAILS(message))
        si

        init(test: TEST, message: string, details: string?) is
            init(test, DETAILS(message, details))
        si

        add(details: DETAILS) is
            _details.add(details)
        si
    si

    class DETAILS(message: string, details: string?) is
        init(message: string) is
            init(message, null)
        si


        to_string() -> string is
            let result = StringBuilder()

            result.append(message)

            if let self.details then
                result
                    .append(":")

                if !details.contains('\n') then
                    result
                        .append(" ")
                        .append(details)
                else
                    for line in details.split(['\n']) do
                        result
                            .append("\n    ")
                            .append(line)
                    od
                fi
            fi

            return result.to_string()
        si
    si

    // How long a test's program ran for, and how long it was silent before it
    // said anything at all. The two answer different questions: the first says
    // what the program costs, the second what a reader waiting for it to do
    // something visible sits through - which is what the playground's readers
    // wait through too, under a runtime many times slower than this one.
    //
    // Marked from the runner as the program runs: started when the process has
    // been created, first output when its earliest output arrives, finished
    // once it has exited. A program that says nothing leaves first output
    // absent.
    class TIMING is
        _started_ms: long private
        _finished_ms: long private
        _first_output_ms: long? private

        run_ms: int public =>
            cast int(_finished_ms - _started_ms)

        first_output_ms: int? public =>
            if let first = _first_output_ms then
                cast int(first - _started_ms)
            fi

        init() is si

        mark_started(ms: long) is
            _started_ms = ms
        si

        mark_finished(ms: long) is
            _finished_ms = ms
        si

        mark_first_output(ms: long) is
            if !_first_output_ms? then
                _first_output_ms = ms
            fi
        si

        to_string() -> string =>
            if let first = first_output_ms then
                "run {run_ms} ms, first output {first} ms"
            else
                "run {run_ms} ms, no output"
            fi
    si
si
