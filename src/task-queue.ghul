namespace Tester is
    use IO.Std

    use Collections.Iterable
    use Ghul.Pipes
    use Collections.LIST

    class TASK_QUEUE(max_tasks: int private) is
        _running_tasks: LIST[Tasks.TASK[Result]]

        init(..) is
            _running_tasks = LIST[Tasks.TASK[Result]](max_tasks)
        si

        queue(task: () -> Result) -> Iterable[Result] is
            let result = wait_any()

            let new_task = Tasks.TASK[Result](task)

            new_task.start()

            _running_tasks.add(new_task)

            return result
        si

        drain() -> Iterable[Result]? is
            if _running_tasks.count == 0 then
                return null
            fi

            return wait_all()
        si

        wait_any() -> Iterable[Result] => wait(false)
        wait_all() -> Iterable[Result] => wait(true)

        wait(all: bool) -> Iterable[Result] is
            let result = LIST[Result]()

            if !all /\ _running_tasks.count < _max_tasks then
                return result
            fi

            Tasks.TASK.wait_any(_running_tasks |> map(t -> Tasks.TASK => t) |> ARRAY())

            let new_tasks = LIST[Tasks.TASK[Result]]()

            for task in _running_tasks do
                if task.is_completed then
                    result.add(task.result)
                else
                    new_tasks.add(task)
                fi
            od

            _running_tasks = new_tasks

            return result
        si
    si
si

