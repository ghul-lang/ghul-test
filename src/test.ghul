namespace Tester is
    use Collections.Iterable
    use Ghul.Pipes

    class TEST(
        path: string,
        source_files: Iterable[string],
        flags: string,
        is_build_fail_expected: bool,
        tags: Iterable[string]
    ) is
        // A library has no entry point, so there is nothing to run and
        // never was: a test that builds one is asserting the shape of
        // what was emitted, not what it does. Running it produces a
        // host error about a missing runtime configuration, which says
        // nothing about the test.
        is_library: bool =>
            flags.split([' ', '\t', '\r', '\n']) |> any(f => f =~ "--library")

        // A test built with `--target wasm` builds a WebAssembly module and
        // a JavaScript loader beside it, and its program is run by Node
        // through the loader rather than by the .NET host.
        is_wasm() -> bool => names_wasm_target(flags)

        // Whether `options`, compiler options as a command line or a
        // project file holds them, select the wasm target.
        names_wasm_target(options: string) -> bool static is
            let words = options.split([' ', '\t', '\r', '\n']) |> filter(w => w.length > 0) |> collect()

            for i in 0..words.count - 1 do
                if words[i] =~ "--target" /\ words[i + 1] =~ "wasm" then
                    return true
                fi
            od

            return false
        si

        has_executed: bool => result? /\ result.is_executed
        has_passed: bool => result? /\ result.is_pass
        has_failed: bool => result? /\ result.is_fail

        result: Result? public

        to_string() -> string is
            if let self.result then
                return result.format(path)
            fi

            return "no result: {path}"
        si
    si
si
