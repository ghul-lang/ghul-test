namespace Tester is
    use Collections.Iterable
    use Ghul.Pipes

    class TEST(
        path: string,
        source_files: Iterable[string],
        flags: string,
        is_build_fail_expected: bool,
        tags: Iterable[string]
    ) is
        init(..) is
            name = path
        si

        // A library has no entry point, so there is nothing to run and
        // never was: a test that builds one is asserting the shape of
        // what was emitted, not what it does. Running it produces a
        // host error about a missing runtime configuration, which says
        // nothing about the test.
        is_library: bool =>
            (project?.is_library ?? false) \/ flags.split([' ', '\t', '\r', '\n']) |> any(f => f =~ "--library")

        // The target the test is built for: said by its project where it is
        // one, or by its flags, and .NET where neither names one.
        target() -> TestTarget => project?.test_target ?? named_target(flags) ?? TestTarget.DOTNET

        // The target `options`, compiler options as a command line or a
        // project file holds them, select with `--target`, or null where
        // they name none.
        named_target(options: string) -> TestTarget? static is
            let words = options.split([' ', '\t', '\r', '\n']) |> filter(w => w.length > 0) |> collect()

            for i in 0..words.count - 1 do
                if words[i] =~ "--target" then
                    return TEST_TARGETS.of(words[i + 1])
                fi
            od

            return null
        si

        // What the test is reported as: its path, or for one variant of a
        // test run under several targets, the path with the target after it.
        name: string public

        has_executed: bool => result? /\ result.is_executed
        has_passed: bool => result? /\ result.is_pass
        has_failed: bool => result? /\ result.is_fail

        // Set for a test that is a ghul-cli project: what is built, and for
        // which target.
        project: PROJECT? public

        // Set for a project test built with the compiler alone rather than
        // with MSBuild: the command and options to build it with.
        direct: DIRECT_BUILD? public

        // Why a project test asked to be built directly is built with
        // MSBuild instead, or null.
        direct_problem: string? public

        result: Result? public

        to_string() -> string is
            if let self.result then
                return result.format(name)
            fi

            return "no result: {name}"
        si
    si
si
