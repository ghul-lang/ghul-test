namespace Tester is
    use IO.Path
    use IO.File
    use IO.Directory

    // Makes the paths a test's output holds independent of where the
    // repository is checked out, so a snapshot holds on every machine.
    class PATH_NORMALISER is
        _libraries: Collections.LIST[(name: string, root: string)]? static

        /// Records that the library `name` was resolved to `root` for this run,
        /// so a path under it is written the same wherever its checkout is.
        ///
        /// - name: the library's name in the configuration
        /// - root: the directory it resolved to
        add_library(name: string, root: string) static is
            let libraries = _libraries ?? Collections.LIST[(name: string, root: string)]()

            _libraries = libraries

            let full = Path.get_full_path(root)

            for (_, existing) in libraries do
                if existing =~ full then
                    return
                fi
            od

            libraries.add((name, full))
        si

        // `content` with the test directory removed from the paths in it,
        // and the paths elsewhere in the checkout written relative to the
        // test directory: a library source next to the tests reads as
        // `../../src/library.ghul` wherever the checkout is.
        //
        // - test_directory: the test's directory, as a full path
        // - checkout_root: the repository's root directory as a full path,
        //   or null where the test is not in a repository
        normalise(content: string, test_directory: string, checkout_root: string?) -> string static =>
            normalise(content, test_directory, checkout_root, _libraries ?? Collections.LIST[(name: string, root: string)]())

        // The same, with a path under one of `libraries` written as the
        // library's name in angle brackets and the path within it, such as
        // `<ghul-core>/src/tasks.ghul`: a library resolves to a different
        // checkout in CI and in a workspace, so neither place appears.
        normalise(
            content: string,
            test_directory: string,
            checkout_root: string?,
            libraries: Collections.Iterable[(name: string, root: string)]
        ) -> string static is
            let result mut = content

            // A longer root first, so a library inside another's root is
            // written as itself. A library holding the test itself, as when
            // its own repository runs its tests, is left to the rules below.
            let ordered = Collections.LIST[(name: string, root: string)](libraries)

            ordered.sort((a: (name: string, root: string), b: (name: string, root: string)) -> int => b.root.length - a.root.length)

            for (name, root) in ordered do
                if !_with_separator(test_directory).starts_with(_with_separator(root)) then
                    result = result.replace(_with_separator(root), "<{name}>/")
                fi
            od

            result = result.replace(_with_separator(test_directory), "")

            if let root = checkout_root then
                let relative = Path.get_relative_path(test_directory, root).replace('\\', '/')

                result = result.replace(_with_separator(root), "{relative}/")
            fi

            return result
        si

        // The nearest directory at or above `directory` that holds a `.git`
        // directory or file, or null where there is none.
        checkout_root(directory: string) -> string? static is
            let current: string? mut = Path.get_full_path(directory)

            while let candidate = current do
                if Directory.exists(Path.combine(candidate, ".git")) \/ File.exists(Path.combine(candidate, ".git")) then
                    return candidate
                fi

                current = Path.get_directory_name(candidate)
            od

            return null
        si

        _with_separator(directory: string) -> string static =>
            if directory.ends_with('/') \/ directory.ends_with('\\') then directory else "{directory}/" fi
    si
si
