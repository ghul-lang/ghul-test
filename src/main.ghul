namespace Tester is
    use System.Exception
    use System.Text.StringBuilder
    use System.Text.UTF8Encoding

    use Collections.Iterable
    use Collections.List
    use Collections.MutableList
    use Collections.LIST

    use IO.Std
    use IO.Directory
    use IO.File

    class Main is
        @suppress("definite-assignment")
        entry(arguments: string[]) -> int static is
            Std.output_encoding = UTF8Encoding()

            if arguments.count == 0 then
                Std.write_line("usage: ghul-test [--config <name>] [--use-dotnet-build [--direct]] [--ci|--no-ci] [--tag <name>]... [--not-tag <name>]... [--target-flags <target> <flags>]... [--shard <index>/<count>] <test-folder>...")
                return 1
            fi

            let host = get_cli_environment_variable("HOST")
            let target = get_cli_environment_variable("TARGET")

            // report_host_and_target(host, target);

            let ci_string =
                System.Environment.get_environment_variable("CI") ?? ""

            // `--ci` and `--no-ci` say outright which of the two the
            // environment variable would have chosen, for the case where the
            // environment says the wrong thing: a job that publishes a
            // compiler to run against is in CI, but wants the published one
            // rather than the tool. With neither, the environment decides.
            let ci_forced mut = -1

            // The mode `--use-dotnet-build` or `--use-ghul-cli` asks for, which
            // takes the compiler from the build rather than from either source
            // `--ci` and `--no-ci` choose between.
            let build_mode: CompilerRunMode? mut = null

            // Whether `--use-dotnet-build` builds a project the runner can
            // read with the compiler alone, rather than with MSBuild.
            let build_directly mut = false

            let run_mode mut =
                if ci_string =~ "1" \/ ci_string.to_lower() =~ "true" then
                    CompilerRunMode.CI
                else
                    CompilerRunMode.LOCAL
                fi

            let runtime_dll_override mut =
                System.Environment.get_environment_variable("GHUL_RUNTIME_DLL")

            let compiler_override mut =
                System.Environment.get_environment_variable("GHUL_TEST_COMPILER")

            let ildasm_override: string? mut =
                System.Environment.get_environment_variable("GHUL_TEST_ILDASM")

            let ghul_command: string? mut = null
            let project_target: string? mut = null

            let test_paths = LIST[string]()
            let requested_tags = LIST[string]()
            let excluded_tags = LIST[string]()
            let target_flags = Collections.MAP[string, string]()

            let shard_spec: string? mut

            // The configuration `--config` names, and whether any option was given
            // that a configuration sets instead, which the two cannot both say.
            let configuration_name: string? mut = null
            let shaped_by_options mut = false

            // The compiler `--compiler` names, which overrides the one a
            // configuration names, where the environment's does not.
            let compiler_option: string? mut = null

            let i mut = 0

            while i < arguments.count do
                let arg = arguments[i]

                if arg =~ "--config" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--config requires a configuration name argument")
                        return 1
                    fi

                    configuration_name = arguments[i]
                elif arg =~ "--use-dotnet-build" then
                    shaped_by_options = true
                    build_mode = CompilerRunMode.DOTNET
                elif arg =~ "--direct" then
                    shaped_by_options = true
                    build_directly = true
                elif arg =~ "--use-ghul-cli" then
                    shaped_by_options = true
                    build_mode = CompilerRunMode.GHUL_CLI
                elif arg =~ "--ci" then
                    shaped_by_options = true

                    if ci_forced == 0 then
                        Std.write_line("--ci and --no-ci cannot both be given")
                        return 1
                    fi

                    ci_forced = 1
                    run_mode = CompilerRunMode.CI
                elif arg =~ "--no-ci" then
                    shaped_by_options = true

                    if ci_forced == 1 then
                        Std.write_line("--ci and --no-ci cannot both be given")
                        return 1
                    fi

                    ci_forced = 0
                    run_mode = CompilerRunMode.LOCAL
                elif arg =~ "--ghul" then
                    shaped_by_options = true
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--ghul requires a command argument")
                        return 1
                    fi

                    ghul_command = arguments[i]
                elif arg =~ "--target" then
                    shaped_by_options = true
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--target requires a target name argument")
                        return 1
                    fi

                    project_target = arguments[i]
                elif arg =~ "--runtime-dll" then
                    shaped_by_options = true
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--runtime-dll requires a path argument")
                        return 1
                    fi

                    runtime_dll_override = arguments[i]
                elif arg =~ "--compiler" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--compiler requires a command argument")
                        return 1
                    fi

                    compiler_option = arguments[i]
                    compiler_override = arguments[i]
                elif arg =~ "--ildasm" then
                    shaped_by_options = true
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--ildasm requires a path argument")
                        return 1
                    fi

                    ildasm_override = arguments[i]
                elif arg =~ "--shard" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--shard requires an <index>/<count> argument")
                        return 1
                    fi

                    shard_spec = arguments[i]
                elif arg =~ "--tag" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--tag requires a tag name argument")
                        return 1
                    fi

                    requested_tags.add(arguments[i])
                elif arg =~ "--not-tag" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--not-tag requires a tag name argument")
                        return 1
                    fi

                    excluded_tags.add(arguments[i])
                elif arg =~ "--target-flags" then
                    shaped_by_options = true
                    i = i + 2

                    if i >= arguments.count then
                        Std.write_line("--target-flags requires a target name and a flags argument")
                        return 1
                    fi

                    let named = arguments[i - 1]

                    if !TEST_TARGETS.of(named)? then
                        Std.write_line("--target-flags names {named}, which is not a target ghul-test can run")
                        return 1
                    fi

                    target_flags[named] = if target_flags.contains_key(named) then "{target_flags[named]} {arguments[i]}" else arguments[i] fi
                else
                    test_paths.add(arg)
                fi

                i = i + 1
            od

            let publish_directory: string? mut = null
            let published_command: string? mut = null
            let run_targets: Collections.List[TestTarget]? mut = null

            let configuration_file = RUN_CONFIGURATION.find_file(Directory.get_current_directory())

            try
                if !configuration_name? /\ !shaped_by_options then
                    if let file = configuration_file then
                        configuration_name = RUN_CONFIGURATION.default_name(file)
                    fi
                fi
            catch ex: Exception
                Std.write_line(ex.message)
                return 1
            yrt

            if let name = configuration_name then
                if shaped_by_options then
                    Std.write_line("--config cannot be given with an option the configuration sets; of those only --compiler can override it")
                    return 1
                fi

                let file = configuration_file

                if !file? then
                    Std.write_line("--config {name}: no {RUN_CONFIGURATION.FILE} in the working directory or above it")
                    return 1
                fi

                let configuration: RUN_CONFIGURATION mut

                try
                    configuration = RUN_CONFIGURATION.read(file, name)
                catch ex: Exception
                    Std.write_line(ex.message)
                    return 1
                yrt

                Std.write_line("configuration: {name} from {file}")

                build_mode =
                    if configuration.build =~ "msbuild" \/ configuration.build =~ "direct" then
                        CompilerRunMode.DOTNET
                    elif configuration.build =~ "ghul-cli" then
                        CompilerRunMode.GHUL_CLI
                    else
                        null
                    fi

                build_directly = configuration.build =~ "direct"
                run_mode = if configuration.uses_tool then CompilerRunMode.CI else CompilerRunMode.LOCAL fi
                runtime_dll_override = configuration.runtime_path
                ildasm_override = ildasm_override ?? configuration.ildasm
                ghul_command = configuration.ghul_command
                project_target = configuration.ghul_target

                run_targets = configuration.run_targets

                for (target, flags) in configuration.target_flags do
                    target_flags[target] = flags
                od

                if configuration.build =~ "compiler" then
                    publish_directory = configuration.publish_directory
                    published_command = configuration.compiler_command
                    compiler_override = null

                    if let named = compiler_option then
                        publish_directory = COMPILER_OPTION.publish_directory_of(named)
                        published_command = null
                        run_mode = CompilerRunMode.LOCAL
                    fi
                else
                    compiler_override = compiler_option ?? configuration.compiler_command
                fi

                if let mode = build_mode then
                    run_mode = mode
                fi
            elif let mode = build_mode then
                if ci_forced >= 0 then
                    Std.write_line("--ci and --no-ci cannot be given with --use-dotnet-build or --use-ghul-cli, which take the compiler from the build")
                    return 1
                fi

                run_mode = mode
            fi

            let compiler_under_test = COMPILER_UNDER_TEST(run_mode, publish_directory, published_command)

            let disassembler: DISASSEMBLER mut

            try
                compiler_under_test.set_runtime_path(runtime_dll_override)
                compiler_under_test.set_compiler_command(compiler_override)
                compiler_under_test.set_ghul_command(ghul_command)
                compiler_under_test.set_build_directly(build_directly)
                compiler_under_test.project_target = project_target

                disassembler = DISASSEMBLER(ildasm_override)
            catch ex: Exception
                Std.write_line(ex.message)
                return 1
            yrt

            if run_mode == CompilerRunMode.DOTNET then
                report_compiler_under_test(compiler_under_test)
            fi

            let tag_filter = TAG_FILTER(requested_tags, excluded_tags)

            if requested_tags.count > 0 then
                Std.write_line("filtering to tests tagged: {string.join(", ", requested_tags)}")
            fi

            if excluded_tags.count > 0 then
                Std.write_line("excluding tests tagged: {string.join(", ", excluded_tags)}")
            fi

            let shard: SHARD mut

            try
                if shard_spec? then
                    shard = SHARD.parse(shard_spec)

                    Std.write_line("running {shard.description}")
                else
                    shard = SHARD.whole()
                fi
            catch ex: Exception
                Std.write_line(ex.message)
                return 1
            yrt

            let requested = TEST_PATHS.distinct(test_paths)

            if requested.dropped > 0 then
                Std.write_line("ignoring {requested.dropped} repeated test path(s)")
            fi

            let queue =
                TEST_QUEUE(
                    host,
                    target,
                    compiler_under_test,
                    disassembler,
                    PROGRESS_REPORTER(requested.paths),
                    tag_filter,
                    shard,
                    target_flags)

            queue.run_targets = run_targets

            for path in requested.paths do
                if !Directory.exists(path) then
                    Std.write_line("not a directory: {path}")
                    return 1
                fi

                queue.try_queue_tests(path)
            od

            queue.run_queued_tests()

            if shard.is_whole then
                Std.write_line("{queue.count} tests discovered")
            else
                Std.write_line(
                    "{queue.count} of {queue.candidate_count} tests discovered "
                    "for {shard.description}")
            fi
            Std.write_line("{queue.executed_count} tests enabled")

            if queue.passed_over_count > 0 then
                Std.write_line("{queue.passed_over_count} tests passed over for targets the configuration does not run")
            fi

            Std.write_line("{queue.pass_count}/{queue.executed_count} tests passed")

            for reason in queue.undiscovered do
                Std.write_line("not run: {reason}")
            od

            if queue.fail_count == 0 /\ queue.undiscovered_count == 0 then
                Std.write_line("{cast char(9989)} all tests passed {cast char(9989)}")
                return 0
            fi

            if queue.fail_count == 0 then
                Std.write_line("{cast char(10060)} {queue.undiscovered_count} test directories not run {cast char(10060)}")

                return 1
            fi

            Std.write_line("{cast char(10060)} {queue.fail_count} tests failed {cast char(10060)}")

            return 1
        si

        // Which compiler a `dotnet build` run reaches for is otherwise invisible
        // -- a project whose compiler is left to the local tool manifest builds
        // just as quietly with a published compiler as with the one being
        // tested, so say which it is.
        report_compiler_under_test(compiler_under_test: COMPILER_UNDER_TEST) static is
            if let compiler_command = compiler_under_test.compiler_command then
                Std.write_line("compiler under test: {compiler_command}")
            else
                Std.write_line("compiler under test: whatever each project resolves for itself")
            fi
        si

        report_host_and_target(host: string, target: string) static is
            Std.write_line("compiler hosted on: {get_cli_description(host)}")
            Std.write_line("built tests executed on: {get_cli_description(target)}")
        si

        get_cli_description(name: string) -> string static is
            if name =~ "mono" then
                return "Mono"
            elif name =~ "dotnet" then
                return ".NET"
            fi

            throw Exception("unknown CLI environment: {name}")
        si

        get_cli_environment_variable(name: string) -> string static =>
            System.Environment.get_environment_variable(name) ?? "dotnet"
    si
si
