namespace Tester is
    use System.Exception
    use System.Text.StringBuilder
    use System.Text.UTF8Encoding

    use Collections.Iterable
    use Collections.List
    use Collections.MutableList
    use Collections.LIST

    use IO.Std
    use IO.Directory
    use IO.File

    class Main is
        @suppress("definite-assignment")
        entry(arguments: string[]) -> int static is
            Std.output_encoding = UTF8Encoding()

            if arguments.count == 0 then
                Std.write_line("usage: ghul-test [--config <name>] [--compiler <command>] [--tag <name>]... [--not-tag <name>]... [--shard <index>/<count>] <test-folder>...")
                return 1
            fi

            // The program a .NET test's binary runs under.
            let host = "dotnet"
            let target = "dotnet"

            let ildasm_override: string? mut =
                System.Environment.get_environment_variable("GHUL_TEST_ILDASM")

            let test_paths = LIST[string]()
            let requested_tags = LIST[string]()
            let excluded_tags = LIST[string]()
            let target_flags = Collections.MAP[string, string]()

            let shard_spec: string? mut

            let configuration_name: string? mut = null

            // The compiler `--compiler` names, which overrides the one the
            // configuration names.
            let compiler_option: string? mut = null

            let i mut = 0

            while i < arguments.count do
                let arg = arguments[i]

                if arg =~ "--config" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--config requires a configuration name argument")
                        return 1
                    fi

                    configuration_name = arguments[i]
                elif arg =~ "--compiler" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--compiler requires a command argument")
                        return 1
                    fi

                    compiler_option = arguments[i]
                elif arg =~ "--shard" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--shard requires an <index>/<count> argument")
                        return 1
                    fi

                    shard_spec = arguments[i]
                elif arg =~ "--tag" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--tag requires a tag name argument")
                        return 1
                    fi

                    requested_tags.add(arguments[i])
                elif arg =~ "--not-tag" then
                    i = i + 1

                    if i >= arguments.count then
                        Std.write_line("--not-tag requires a tag name argument")
                        return 1
                    fi

                    excluded_tags.add(arguments[i])
                elif let replacement = REMOVED_OPTIONS.replacement(arg) then
                    Std.write_line("{arg} was removed in ghul-test 6.0.0: {replacement}")
                    return 1
                else
                    test_paths.add(arg)
                fi

                i = i + 1
            od

            let configuration_file = RUN_CONFIGURATION.find_file(Directory.get_current_directory())

            if !configuration_file? then
                Std.write_line("no {RUN_CONFIGURATION.FILE} in the working directory or above it, to say how tests are run")
                return 1
            fi

            let configuration: RUN_CONFIGURATION mut

            try
                let name = configuration_name ?? RUN_CONFIGURATION.default_name(configuration_file)

                if !name? then
                    Std.write_line("{configuration_file} names no default configuration, so a run names one with --config")
                    return 1
                fi

                configuration = RUN_CONFIGURATION.read(configuration_file, name)

                Std.error.write_line("configuration: {name} from {configuration_file}")
            catch ex: Exception
                Std.write_line(ex.message)
                return 1
            yrt

            let build_directly = configuration.build =~ "direct"
            let runtime_dll_override = configuration.runtime_path
            let ghul_command = configuration.ghul_command
            let project_target = configuration.ghul_target
            let run_targets = configuration.run_targets

            ildasm_override = ildasm_override ?? configuration.ildasm

            for (flags_target, flags) in configuration.target_flags do
                target_flags[flags_target] = flags
            od

            let run_mode mut =
                if configuration.build =~ "msbuild" \/ configuration.build =~ "direct" then
                    CompilerRunMode.DOTNET
                elif configuration.build =~ "ghul-cli" then
                    CompilerRunMode.GHUL_CLI
                elif configuration.uses_tool then
                    CompilerRunMode.CI
                else
                    CompilerRunMode.LOCAL
                fi

            let publish_directory: string? mut = null
            let published_command: string? mut = null
            let compiler_override: string? mut = null

            if configuration.build =~ "compiler" then
                publish_directory = configuration.publish_directory
                published_command = configuration.compiler_command

                if let named = compiler_option then
                    publish_directory = COMPILER_OPTION.publish_directory_of(named)
                    published_command = null
                    run_mode = CompilerRunMode.LOCAL
                fi
            else
                compiler_override = compiler_option ?? configuration.compiler_command
            fi

            let compiler_under_test: COMPILER_UNDER_TEST mut
            let disassembler: DISASSEMBLER mut

            try
                compiler_under_test = COMPILER_UNDER_TEST(run_mode, publish_directory, published_command)

                compiler_under_test.set_runtime_path(runtime_dll_override)
                compiler_under_test.set_compiler_command(compiler_override)
                compiler_under_test.set_ghul_command(ghul_command)
                compiler_under_test.set_build_directly(build_directly)
                compiler_under_test.project_target = project_target

                disassembler = DISASSEMBLER(ildasm_override)
            catch ex: Exception
                Std.write_line(ex.message)
                return 1
            yrt

            if run_mode == CompilerRunMode.DOTNET then
                report_compiler_under_test(compiler_under_test)
            fi

            let tag_filter = TAG_FILTER(requested_tags, excluded_tags)

            if requested_tags.count > 0 then
                Std.write_line("filtering to tests tagged: {string.join(", ", requested_tags)}")
            fi

            if excluded_tags.count > 0 then
                Std.write_line("excluding tests tagged: {string.join(", ", excluded_tags)}")
            fi

            let shard: SHARD mut

            try
                if shard_spec? then
                    shard = SHARD.parse(shard_spec)

                    Std.write_line("running {shard.description}")
                else
                    shard = SHARD.whole()
                fi
            catch ex: Exception
                Std.write_line(ex.message)
                return 1
            yrt

            let requested = TEST_PATHS.distinct(test_paths)

            if requested.dropped > 0 then
                Std.write_line("ignoring {requested.dropped} repeated test path(s)")
            fi

            let queue =
                TEST_QUEUE(
                    host,
                    target,
                    compiler_under_test,
                    disassembler,
                    PROGRESS_REPORTER(requested.paths),
                    tag_filter,
                    shard,
                    target_flags)

            queue.run_targets = run_targets
            queue.build_targets = configuration.build_targets
            queue.package_flags = configuration.package_flags

            for path in requested.paths do
                if !Directory.exists(path) then
                    Std.write_line("not a directory: {path}")
                    return 1
                fi

                queue.try_queue_tests(path)
            od

            queue.run_queued_tests()

            if shard.is_whole then
                Std.write_line("{queue.count} tests discovered")
            else
                Std.write_line(
                    "{queue.count} of {queue.candidate_count} tests discovered "
                    "for {shard.description}")
            fi
            Std.write_line("{queue.executed_count} tests enabled")

            if queue.passed_over_count > 0 then
                Std.write_line("{queue.passed_over_count} tests passed over for targets the configuration does not run")
            fi

            Std.write_line("{queue.pass_count}/{queue.executed_count} tests passed")

            for reason in queue.undiscovered do
                Std.write_line("not run: {reason}")
            od

            if queue.fail_count == 0 /\ queue.undiscovered_count == 0 then
                Std.write_line("{cast char(9989)} all tests passed {cast char(9989)}")
                return 0
            fi

            if queue.fail_count == 0 then
                Std.write_line("{cast char(10060)} {queue.undiscovered_count} test directories not run {cast char(10060)}")

                return 1
            fi

            Std.write_line("{cast char(10060)} {queue.fail_count} tests failed {cast char(10060)}")

            return 1
        si

        // Which compiler a `dotnet build` run reaches for is otherwise invisible
        // -- a project whose compiler is left to the local tool manifest builds
        // just as quietly with a published compiler as with the one being
        // tested, so say which it is.
        report_compiler_under_test(compiler_under_test: COMPILER_UNDER_TEST) static is
            if let compiler_command = compiler_under_test.compiler_command then
                Std.write_line("compiler under test: {compiler_command}")
            else
                Std.write_line("compiler under test: whatever each project resolves for itself")
            fi
        si

        report_host_and_target(host: string, target: string) static is
            Std.write_line("compiler hosted on: {get_cli_description(host)}")
            Std.write_line("built tests executed on: {get_cli_description(target)}")
        si

        get_cli_description(name: string) -> string static is
            if name =~ "mono" then
                return "Mono"
            elif name =~ "dotnet" then
                return ".NET"
            fi

            throw Exception("unknown CLI environment: {name}")
        si
    si
si

namespace Tester is
    /// The options ghul-test 6.0.0 removed in favour of a configuration in
    /// `ghul-test.json`, and what to write instead.
    class REMOVED_OPTIONS is
        /// What replaces `option`, or null where it was never removed.
        ///
        /// - option: a command-line argument
        replacement(option: string) -> string? static =>
            if option =~ "--ci" \/ option =~ "--no-ci" then
                "a configuration names its compiler: \"tool\", or an object naming publish or path"
            elif option =~ "--use-dotnet-build" \/ option =~ "--direct" \/ option =~ "--use-ghul-cli" then
                "a configuration names its build: msbuild, direct or ghul-cli"
            elif option =~ "--ghul" \/ option =~ "--target" then
                "a ghul-cli configuration names its ghul and ghul_target"
            elif option =~ "--runtime-dll" then
                "a configuration names its runtime"
            elif option =~ "--ildasm" then
                "a configuration names its ildasm, or set GHUL_TEST_ILDASM"
            elif option =~ "--target-flags" then
                "a configuration names each target's flags and libraries under targets"
            else
                null
            fi
    si
si
